; REVIEW DRAFT - NOT MACHINE VALIDATED - CAM F/S ONLY
; Both ArtCAM 2011 and 2018 exports must be checked.
; STAY: CAM must fully clear HV laterally before ANY Z lift, including END.
; This file cannot choose pendant F/S settings. No automatic tool changes.
; Original attribution retained below.
; 06.01.2013 постпроцессор откорректирован - добавленя поддержка дуговых сегментов
; это значительно улучшает качество расчета программой скоростей и ускорений при движении по кривым.
; Михаил Юров    michael-yurov@ya.ru
; 
; G - Code для NC-Studio  - по сути это тот-же CREATION.con , только для удобства переобозван 
; проверен на ФуЯнгах, Creaton Pcun (c 6й версией NC-Studio) и ряде других станков
; 
; Размещение в интернете только со ссылкой на первоисточник: http://mir-cnc.ru
; С уважением....
;     Большаков Вадим (3D-BiG)
;     E-mail: 3d-big@mail.ru
;
; версия от 10.10.2004   
;
DESCRIPTION = "PARAD A11 REVIEW CAM_FS_STAY (*.nc)"
;
FILE_EXTENSION = "nc"
;
UNITS = MM
;
; Cariage return - line feed at end of each line
;
END_OF_LINE = "[13][10]"
;
; Block numbering 
;
LINE_NUM_START     = 0
LINE_NUM_INCREMENT = 10
LINE_NUM_MAXIMUM   = 999999
;
; Set up default formating for variables
;
; Line numbering
FORMAT = [N|@|N|1.0]
; Spindle Speed
FORMAT = [S|@|S|1.0]
; Feed Rate
FORMAT = [F|#|F|1.1]
; Tool moves in x,y and z
FORMAT = [X|#|X|1.3]
FORMAT = [Y|#|Y|1.3]
FORMAT = [Z|#|Z|1.3]
; Arc Center Coords
FORMAT = [I|@|I|1.3]
FORMAT = [J|@|J|1.3]
; Home tool positions 
FORMAT = [XH|@|X|1.3]
FORMAT = [YH|@|Y|1.3]
FORMAT = [ZH|@|Z|1.3]
;
; Set up program header
;
START = "%"
START = "G90"
START = "G21"
START = "G17"
START = "M5"
START = "G0[ZH]"
START = "G0[XH][YH]"
START = "M3[S]"
;
; Program moves
;
RAPID_RATE_MOVE        = "G0[X][Y][Z]"
FIRST_FEED_RATE_MOVE   = "G1[X][Y][Z][F]"
FEED_RATE_MOVE         = "G1[X][Y][Z][F]"
;
FIRST_CW_ARC_MOVE      = "G2 [X] [Y] [I] [J] [F]"
CW_ARC_MOVE            = "G2 [X] [Y] [I] [J] [F]"
;
FIRST_CCW_ARC_MOVE     = "G3 [X] [Y] [I] [J] [F]"
CCW_ARC_MOVE           = "G3 [X] [Y] [I] [J] [F]"
;
; End of file
;
END = "G0[ZH]"
END = "M5"
END = "M30"
